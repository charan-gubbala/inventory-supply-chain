# Environment Variables Configuration
# Copy this file to .env for local overrides

# Application
PROJECT_NAME="Inventory & Supply Chain Demand Planning System"
VERSION="1.0.0"
API_PREFIX="/api"

# Database Configuration
# Default local SQLite:
DATABASE_URL=sqlite:///./supply_chain.db
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/supply_chain

# CORS Whitelist (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Deterministic Pseudo-Random Seed
RANDOM_SEED=20261022
